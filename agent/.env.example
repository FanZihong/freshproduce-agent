# LLM 查询改写配置（DeepSeek 兼容 OpenAI 协议）
# 用法：复制成 .env，填入自己的 key，再把 LLM_REWRITE_ENABLED 改成 true

# 是否启用 LLM 改写；关闭时全部走规则版改写
LLM_REWRITE_ENABLED=false

# 你的 API Key（占位，替换成真实值）
LLM_API_KEY=sk-替换成你的-deepseek-key

# DeepSeek 的 OpenAI 兼容地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 改写模型；如果账号没有 deepseek-flash，可改成 deepseek-chat
LLM_REWRITE_MODEL=deepseek-flash

# 单次调用超时（秒）
LLM_REWRITE_TIMEOUT=20

# 向量模型与重排模型：可填 HuggingFace 名称，也可填本地路径
# 从 ModelScope 等国内源下载后，把绝对路径填在这里即可跳过 HF 下载
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# 知识问答用哪种重排：score（0 成本，默认）或 bge（CrossEncoder 精排）
FAQ_RERANK=score

# 检索路：hybrid（默认，混合 + RRF）| vector（纯向量）
# 消融显示在这份评测集上纯向量 recall 更高（0.90 vs 0.8667），但端到端对话零差异；
# 切之前先跑 regression.py，并在报告里写清"端到端未观测到收益"。
RETRIEVAL_KIND=hybrid

# 意图预标注（scripts/label_intent.py）
LABEL_MODEL=deepseek-chat
LABEL_CONCURRENCY=6

# 意图识别后端：rule（关键词，默认，离线可用）| fewshot（大模型基线）| local（本地 LoRA 小模型）
# 改成 fewshot 后，图里的意图节点和 scripts/eval_intent.py 都会走大模型
INTENT_BACKEND=rule

# few-shot 基线用的模型；留空则沿用 LABEL_MODEL
INTENT_MODEL=deepseek-chat

# 单次调用超时（秒）；超时报错多时可以调大，或者把评测并发降下来
INTENT_TIMEOUT=30

# 本地 SFT 模型的推理上下文：off（默认，和单轮训练数据一致）
# | on（拼"上一轮问题/已知记忆"，需要按带上下文的样本再训一版，否则模型容易复读提示词）
LOCAL_INTENT_CONTEXT=off

# 成本口径：元 / 百万 token（默认按 deepseek-chat 档位的假设值，官方调价或换模型请改这里）
INTENT_PRICE_IN=2.0
INTENT_PRICE_OUT=8.0

# Memory 存储后端：auto（有 REDIS_URL 就用 Redis，连不上回落 SQLite）| sqlite | redis
# redis 是强要求：没配 REDIS_URL 或连不上会直接报错，不会静默降级
MEMORY_STORE=auto
# Redis 连接串（装了 redis-server 并启动后可用）：
#   docker run -d -p 6379:6379 redis:7
#   REDIS_URL=redis://localhost:6379/0
# REDIS_URL=

# 对话压缩方式：rule（默认，每条消息压一行，零成本可复现）| llm（摘要模型）| auto（有 key 就 llm）
# LLM 摘要沿用下面的 LLM_API_KEY / LLM_BASE_URL，模型可单独指定：
#   MEMORY_SUMMARY_MODEL=deepseek-chat
MEMORY_SUMMARY=rule

# 同一会话的并发请求串行等待上限（秒）：超时不再排队，直接回"上一条还在处理"
SESSION_LOCK_TIMEOUT=30

# 事实记忆：off（默认，不写）| rule（用摘要生成一条事实，零成本）| llm（抽取增量事实）
# 抽取触发点是"压缩节点"与"转人工"，不是每轮都调，成本自然被限流
MEMORY_FACTS=off
# 相似去重阈值：同会话里两条事实的嵌入相似度超过它就算"换说法"，走更新而不是新增
MEMORY_DEDUPE_SIM=0.92
# 抽取用哪个模型（留空沿用 LLM_REWRITE_MODEL）
# MEMORY_EXTRACT_MODEL=deepseek-chat

# 事实记忆召回：off（默认，不注入）| on（新话题轮召回 top-k 注入意图上下文；
# 正在补槽位的那一轮跳过——"一半吧""订单号 xxx"这种碎片不需要额外上下文）
MEMORY_RECALL=off
# 召回条数上限与相似度门槛：低于门槛的事实不注入（防噪声）；
# 查询里出现订单号/商品名且事实里也有的，按实体命中放行（短查询的向量分通常不够）
MEMORY_RECALL_TOPK=3
MEMORY_RECALL_SIM=0.55

# 事实老化：召回排序时按"多久没被用过"降权，半衰期 14 天、最低保留 50% 权重。
# 只影响排序，不改 vector_score（注入门槛仍看相关性）。
MEMORY_DECAY=on
MEMORY_DECAY_HALF_LIFE_DAYS=14
MEMORY_DECAY_FLOOR=0.5

# 事实过期：超过 N 天没被召回就清理（读时过滤 + scripts/memory_maintenance.py 批量删）。
# 0 表示永不过期；摘要的 TTL 是 7 天，事实更长，因为售后跟进常常跨月。
MEMORY_FACT_TTL_DAYS=30
# 后端启动时是否顺带清理一次过期事实（也可用 cron 跑 memory_maintenance.py）
MEMORY_PURGE_ON_STARTUP=on

# Skills：技能包根目录（默认 data/skills，扫描 <dir>/*/SKILL.md）
# SKILLS_DIR=

# 是否启用技能节点（off 时图里没有 skill 节点，行为与以前完全一样）
SKILLS_ENABLED=on
# 单次注入正文的 token 预算、路由阈值、与第二名的差距（低于阈值/差距太小就不注入）
SKILL_MAX_TOKENS=600
SKILL_MIN_SCORE=3.0
SKILL_MARGIN=1.0
# 用户追问细节时才加载 references/：单次注入预算 + 最多加载几个文件
SKILL_DETAIL_TOKENS=800
SKILL_MAX_REFERENCES=2
# 技能作答：off（默认，回复仍走原规则模板）| llm（技能正文注入 system prompt 生成回复）
SKILL_ANSWER=off
# SKILL_ANSWER_MODEL=deepseek-chat
# SKILL_ANSWER_TIMEOUT=20

# 护栏：总开关（off 时全部回退到迁移前的内置逻辑）、规则目录、步数与 rewrite 深度
RAILS_ENABLED=on
# RAILS_DIR=
RAILS_MAX_STEPS=32
RAILS_MAX_REWRITES=3
